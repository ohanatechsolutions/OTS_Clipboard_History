<Window x:Class="OTS.Clipboard.History.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTS Clipboard History" Icon="pack://application:,,,/Resources/App.ico"
        Width="1080" Height="760" MinWidth="790" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#0F172A" Foreground="#FFFFFF"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#34587C"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EFF6FF"/>
            <Setter Property="Background" Value="#24405E"/>
            <Setter Property="BorderBrush" Value="#39526C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#34587C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#182D45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipRow" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="6,5,6,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="Card" CornerRadius="12" BorderThickness="1"
                                BorderBrush="#304258" Background="#1E293B">
                            <DataGridCellsPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#25364B"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4E79A7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#24405E"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#8BA8CD"/>
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4E79A7" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.28"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ClipCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,23,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#1E293B" BorderBrush="#3D536C" BorderThickness="1"
                        CornerRadius="12" Padding="9" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Resources/App.ico" Width="33" Height="33"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OTS Clipboard History" Foreground="#FFFFFF"
                               FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Your workspace for everything you've copied"
                               Foreground="#8BA8CD" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#193249" BorderThickness="1"
                    BorderBrush="#34587C" CornerRadius="18" Padding="14,8"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="#74D9C4"
                             VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#74D9C4" BlurRadius="8"
                                              ShadowDepth="0" Opacity="0.65"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="RecordingLabel" Text="Recording"
                               FontWeight="SemiBold" Foreground="#D6E5F6"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Border Background="#1E293B" BorderBrush="#34587C" BorderThickness="1"
                    CornerRadius="12" Height="48" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#34587C"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="#8BA8CD"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#4E79A7" BlurRadius="10"
                                                          ShadowDepth="0" Opacity="0.27"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="17,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⌕" Grid.Column="0" Foreground="#8BA8CD"
                               FontSize="25" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" TextChanged="SearchBox_TextChanged"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFFFFF" CaretBrush="#8BA8CD"
                             FontSize="14" VerticalContentAlignment="Center"
                             ToolTip="Search clipboard text and clip categories"/>
                </Grid>
            </Border>
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" Height="48" SelectedIndex="0"
                      Background="#1E293B" Foreground="#FFFFFF"
                      BorderBrush="#34587C" BorderThickness="1"
                      SelectionChanged="CategoryFilter_SelectionChanged"
                      Padding="12,7" FontWeight="SemiBold">
                <ComboBoxItem Content="All clips" Tag="All"/>
                <ComboBoxItem Content="Text" Tag="Text"/>
                <ComboBoxItem Content="Code" Tag="Code"/>
                <ComboBoxItem Content="Links" Tag="Links"/>
                <ComboBoxItem Content="Colors" Tag="Color"/>
                <ComboBoxItem Content="Images" Tag="Image"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,17">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="ClearHistoryButton" Content="Clear history  ▾"
                    Style="{StaticResource ActionButton}" Click="ClearHistoryButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Last 15 minutes" Tag="15m" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 30 minutes" Tag="30m" Click="ClearRange_Click"/>
                        <Separator/>
                        <MenuItem Header="Last 1 hour" Tag="1h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 2 hours" Tag="2h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 3 hours" Tag="3h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 4 hours" Tag="4h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 5 hours" Tag="5h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 6 hours" Tag="6h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 12 hours" Tag="12h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 24 hours" Tag="24h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 48 hours" Tag="48h" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 72 hours" Tag="72h" Click="ClearRange_Click"/>
                        <Separator/>
                        <MenuItem Header="Last 1 week" Tag="1w" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 1 month" Tag="1mo" Click="ClearRange_Click"/>
                        <MenuItem Header="Last 1 year" Tag="1y" Click="ClearRange_Click"/>
                        <Separator/>
                        <MenuItem Header="All time / Forever" Tag="all" Click="ClearRange_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="1" Content="Delete selected" Margin="10,0,0,0"
                    Style="{StaticResource ActionButton}" Click="DeleteSelected_Click"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="TrackingCheckBox" Content="Track clipboard" IsChecked="True"
                          VerticalAlignment="Center" Foreground="#E4EEF8"
                          Margin="0,0,20,0" Click="Tracking_Click"/>
                <CheckBox x:Name="AutoStartCheckBox" Content="Start with Windows"
                          VerticalAlignment="Center" Foreground="#E4EEF8"
                          Click="AutoStart_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Border Background="#131F31" BorderBrush="#2C4059" BorderThickness="1"
                    CornerRadius="14" ClipToBounds="True">
                <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="None" GridLinesVisibility="None"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          RowStyle="{StaticResource ClipRow}" CellStyle="{StaticResource ClipCell}"
                          RowBackground="Transparent" AlternatingRowBackground="Transparent"
                          Background="Transparent" Foreground="#FFFFFF"
                          BorderThickness="0" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False" CanUserResizeRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          ClipboardCopyMode="None"
                          PreviewMouseLeftButtonUp="HistoryGrid_PreviewMouseLeftButtonUp"
                          PreviewMouseRightButtonDown="HistoryGrid_PreviewMouseRightButtonDown">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="22,15,14,15">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="#34587C" CornerRadius="9"
                                                    Padding="9,3">
                                                <TextBlock Text="{Binding Kind}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="#EFF7FF"/>
                                            </Border>
                                            <TextBlock Text="  •  Clipboard item" FontSize="11"
                                                       Foreground="#8BA8CD" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="Swatch" Height="30" Width="88"
                                                BorderBrush="#8BA8CD" BorderThickness="1"
                                                CornerRadius="7" HorizontalAlignment="Left"
                                                Background="{Binding SwatchBrush}"
                                                Visibility="Collapsed" Margin="0,0,0,8"/>
                                        <Border x:Name="ImageBox" Visibility="Collapsed"
                                                Background="#0F172A" BorderBrush="#34587C"
                                                BorderThickness="1" CornerRadius="8"
                                                HorizontalAlignment="Left" Margin="0,0,0,7">
                                            <Image Width="145" Height="90" Stretch="Uniform"
                                                   Source="{Binding ImagePreview}" Margin="7"/>
                                        </Border>
                                        <TextBlock x:Name="TextPreview" Text="{Binding Preview}"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="44" FontSize="13"
                                                   LineHeight="20" Foreground="#FFFFFF"
                                                   Margin="0,0,5,0"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsColor}" Value="True">
                                            <Setter TargetName="Swatch" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                            <Setter TargetName="ImageBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                            <Setter TargetName="TextPreview" Property="FontFamily" Value="Consolas"/>
                                            <Setter TargetName="TextPreview" Property="Foreground" Value="#D1E7FF"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="195">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Margin="0,16,23,16">
                                        <TextBlock Text="COPIED" FontSize="10" Foreground="#8BA8CD"
                                                   HorizontalAlignment="Right" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding LocalTimestamp}" Foreground="#C0D4EB"
                                                   FontSize="12" FontFamily="Consolas"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#1E293B" Foreground="#FFFFFF">
                            <MenuItem Header="Copy" Click="Copy_Click"/>
                            <MenuItem Header="Edit" Click="Edit_Click"/>
                            <Separator/>
                            <MenuItem Header="Select / Deselect" Click="ToggleSelection_Click"/>
                            <MenuItem Header="Select All" Click="SelectAll_Click"/>
                            <MenuItem Header="Deselect All" Click="DeselectAll_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete" Click="DeleteSelected_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>
            <TextBlock x:Name="EmptyState" Text="Nothing here yet. Copy text or an image to begin."
                       Foreground="#8BA8CD" FontSize="15" TextAlignment="Center"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="#8BA8CD"
                       VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="CountText" Foreground="#C0D4EB" FontSize="12"
                           Margin="0,0,18,0"/>
                <TextBlock Text="OHANA TECH SOLUTIONS" Foreground="#718DAA"
                           FontWeight="SemiBold" FontSize="10"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
