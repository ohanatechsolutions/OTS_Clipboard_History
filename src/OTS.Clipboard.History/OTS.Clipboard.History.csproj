<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OTS.Clipboard.History</AssemblyName>
    <RootNamespace>OTS.Clipboard.History</RootNamespace>
    <Version>1.2.2</Version>
    <ApplicationTitle>OTS Clipboard History</ApplicationTitle>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <Authors>Ohana Tech Solutions</Authors>
    <Description>Private local Windows clipboard history manager</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\App.ico" />
    <!-- Embed the full-resolution PNG for in-app branding; retain ICO for Windows app identity. -->
    <Resource Include="..\..\assets\branding\OTS_Clipboard_History_Logo.png" Link="Resources\BrandLogo.png" />
  </ItemGroup>
</Project>
