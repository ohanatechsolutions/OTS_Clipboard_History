<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OTS.Clipboard.History</AssemblyName>
    <RootNamespace>OTS.Clipboard.History</RootNamespace>
    <Version>1.1.1</Version>
    <ApplicationTitle>OTS Clipboard History</ApplicationTitle>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <Authors>Ohana Tech Solutions</Authors>
    <Description>Private local Windows clipboard history manager</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Resources\App.ico" />
  </ItemGroup>
</Project>
